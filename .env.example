# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# API security (use separate random secrets of at least 32 characters)
JWT_SECRET=
REFRESH_TOKEN_KEY=
API_ALLOWED_ORIGIN=http://localhost

# Admin account. Set APP_ADMIN_PASSWORD_HASH to password_hash('admin123', PASSWORD_DEFAULT).
APP_ADMIN_USERNAME=Admin
APP_ADMIN_EMAIL=admin@stockroom.local
APP_ADMIN_PASSWORD_HASH=
